{
  "manifest_version": 3,
  "name": "WitWitty 2.0 — Spatial Lens",
  "version": "2.0.0",
  "description": "An explicitly activated, reversible semantic reading lens. Local fixtures, gestures and a localhost companion.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Activate WitWitty on this article"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "extension/*.js",
        "core/*.js",
        "browser/*.js",
        "gesture/*.js",
        "fixtures/*.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
