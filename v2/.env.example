# Load explicitly: node --env-file=v2/.env v2/companion/server.mjs
# Keep this file's real copy (.env) out of Git. Mock mode requires no model credentials.
WW_MODE=mock
# WW_MODE=live
# WW_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
# WW_MODEL_KEY=
# WW_FAST_MODEL=your-supported-fast-model-id
# WW_STRONG_MODEL=your-supported-strong-model-id
# TYPESAFE_API_KEY=
# WW_JEV_MODEL=jev-latest
# Optional stable local pairing token (24+ characters); otherwise generated per launch.
# WW_PAIRING_TOKEN=
